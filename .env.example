# Optional S3-compatible cloud archive (AWS S3, Cloudflare R2, MinIO, etc.)
# Leave blank to store recordings on the server disk under ./recordings
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional server-side encryption setting, e.g. AES256
S3_SSE=
\n# Web Push notifications (generate keys with: npx web-push generate-vapid-keys)\nVAPID_PUBLIC_KEY=\nVAPID_PRIVATE_KEY=\nVAPID_SUBJECT=mailto:admin@example.com\n